{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "types": [],
    "outDir": "dist/angular-ts"
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true },
  "include": ["src/**/*.ts"]
}
