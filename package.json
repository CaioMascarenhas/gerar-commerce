{
  "name": "gerar-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Linha de produtos e framework educacional para e-commerce — IC/UFAL",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "setup": "npm ci --prefix frontend && npm ci --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm test --prefix backend",
    "smoke": "npm run smoke --prefix backend",
    "derive": "npm run derive --prefix backend --",
    "github:sync": "node scripts/github-sync.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
